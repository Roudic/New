DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="change-this-to-a-long-random-string-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Optional: protect POST /api/setup for production seeding
# SETUP_SECRET="your-setup-secret"

# /brain manager dashboard. Login is currently OFF (BRAIN_LOGIN_ENABLED=false
# in src/lib/second-brain/brain-login.ts). APIs run as vinziant@gmail.com
# with no password. JoltCheck /login is separate.
# When restoring the gate, flip that flag to true and set:
# SECOND_BRAIN_PASSWORD="set-a-manager-password"
# SECOND_BRAIN_SECRET="another-long-random-string"  # HMAC only; not NEXTAUTH_SECRET

# /brain Drive + Calendar + Notion panels, synced via Zapier webhooks.
# Names only here — see second-brain/README.md for what each does.
# Leave unset and the panels honestly show "Not connected".
# ZAPIER_CAPTURE_WEBHOOK_URL="set-the-real-zap-trigger-webhook-url"
# ZAPIER_INBOUND_WEBHOOK_SECRET="set-a-long-random-shared-secret"
# SECOND_BRAIN_DRIVE_FOLDER_NAME="set-once-joshua-names-the-real-folder"
# SECOND_BRAIN_CALENDAR_NAME="set-once-joshua-names-the-real-calendar"
# SECOND_BRAIN_NOTION_TARGET_NAME="set-once-joshua-names-the-real-page-or-database"


# Production on Vercel (Turso — free, works with serverless):
# DATABASE_URL="libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-token"
# NEXTAUTH_URL="https://your-app.vercel.app"
